// Cloudflare hosting (Workers with static assets). The site is the built app in ./dist.
// Any address that isn't a file (like /hsr/pulls) serves index.html so the app can route it.
{
  "name": "project-hlith",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
